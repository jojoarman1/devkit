{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devkit",
  "version": "0.2.0",
  "identifier": "com.jojoa.devkit",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "devkit",
        "width": 889,
        "height": 780,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-lcd-text"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "jojoarmani",
    "shortDescription": "Desktop toolbox for developers",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCMzg5MzRFQzQ2OEFEOEIKUldTTHJXakVUcE00cTVvU0FxT2hveDNMalVxdGcxOFpXd3FMTnZjWi9hKzM1elh5Y2EvT0U0b3kK",
      "endpoints": [
        "https://github.com/jojoarman1/devkit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
